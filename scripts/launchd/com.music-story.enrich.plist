<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs scripts/nightly_enrich.sh every 3 hours. launchd runs a missed slot once the Mac wakes.
  Install: copy to ~/Library/LaunchAgents/, then run
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.music-story.enrich.plist
  Remove:  launchctl bootout gui/$(id -u)/com.music-story.enrich
  Edit the two paths below if the repo or uv lives somewhere else.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.music-story.enrich</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>/bin/bash</string>
        <string>/Users/charliechonguyen/Projects/music-story/music-story/scripts/nightly_enrich.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/charliechonguyen/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>UV_BIN</key>
        <string>/opt/homebrew/bin/uv</string>
    </dict>
    <key>StartInterval</key>
    <integer>10800</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/Users/charliechonguyen/Library/Logs/music-story-enrich.err</string>
</dict>
</plist>
