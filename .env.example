# Copy to .env (gitignored). .worktreeinclude copies .env into every worktree.

# Folder holding Streaming_History_*.json and recenttracks-*.csv (absolute path)
DATA_DIR=/Users/charlie/path/to/Spotify Extended Streaming History
# Real pipeline database (default: <repo>/build/music.duckdb)
MUSIC_DB=
# HTTP cache shared by every worktree (default: ~/.cache/music-story)
CACHE_DIR=

# Last.fm: https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_USER=brainchildvn

# Spotify: https://developer.spotify.com/dashboard (owner needs active Premium)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# MusicBrainz asks for a contact in the User-Agent (email or URL)
MUSICBRAINZ_CONTACT=
